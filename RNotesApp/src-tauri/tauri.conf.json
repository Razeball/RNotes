{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RNotes",
  "version": "0.4.4",
  "identifier": "com.razeball.rnotesapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RNotes",
        "width": 1000,
        "height": 600,
        "devtools": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$TEMP/**",
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["rdocx"],
        "name": "RNotes Document",
        "description": "RNotes Document",
        "mimeType": "application/x-rdocx"
      },
      {
        "ext": ["txt"],
        "name": "Text Document",
        "description": "Plain Text Document"
      },
      {
        "ext": ["json"],
        "name": "JSON Document",
        "description": "JSON Document"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzQUM0MTg2QjE0MUI1MjgKUldRb3RVR3hoa0dzVTVIV3A2VWJ6SUs5dXMxc0Z1blhzdlRyUE5kZTJRNnptR0NBc1BoOTlsZUoK",
      "endpoints": [
        "https://github.com/Razeball/RNotes/releases/latest/download/latest.json"
      ]
    }
  }
}
